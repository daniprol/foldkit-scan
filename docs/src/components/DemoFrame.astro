---
// The demo app runs in an iframe so its styles and page title stay out of
// the docs. BASE_URL is '/foldkit-scan' on GitHub Pages.
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/demo-app/`
---

<div class="not-content demo">
  <iframe src={src} title="foldkit-scan demo: a task list" loading="lazy"
  ></iframe>
  <a href={src} target="_blank" rel="noopener">Open the demo in its own tab</a>
</div>

<style>
  .demo {
    margin-top: 1.5rem;
  }
  iframe {
    display: block;
    width: 100%;
    height: 720px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: #f6f7fb;
  }
  a {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
