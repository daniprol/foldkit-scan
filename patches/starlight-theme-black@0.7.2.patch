+
+// Patched: top-level sidebar links go in the first section, and links in
+// nested groups are listed under the nested group's label.
+type Entry = (typeof sidebar)[number]
+type Row = { kind: 'link'; entry: Extract<Entry, { type: 'link' }> } | { kind: 'label'; label: string }
+const topLinks = sidebar.filter((entry): entry is Extract<Entry, { type: 'link' }> => entry.type === 'link')
+const flatten = (entries: Entry[], path: string[] = []): Row[] =>
+  entries.flatMap((entry): Row[] =>
+    entry.type === 'link'
+      ? [{ kind: 'link', entry }]
+      : [{ kind: 'label', label: [...path, entry.label].join(' / ') }, ...flatten(entry.entries, [...path, entry.label])],
+  )
